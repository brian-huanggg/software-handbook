---
// Field switcher (後端 / DevOps / 資安). Topic data comes from the
// starlight-sidebar-topics middleware, so the list and the "current" state
// stay in sync with the topics configured in astro.config.mjs.
import { Icon } from '@astrojs/starlight/components';

interface Props {
	/** `bar` sits inline in the header; `list` stacks vertically in the mobile menu. */
	variant: 'bar' | 'list';
}

const { variant } = Astro.props;
const { topics } = Astro.locals.starlightSidebarTopics;
---

<nav aria-label="領域" class:list={['field-nav', variant]}>
	<ul>
		{
			topics.map((topic) => (
				<li>
					<a href={topic.link} aria-current={topic.isCurrent ? 'page' : undefined}>
						{topic.icon && <Icon name={topic.icon} />}
						{topic.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
	}
	a {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-weight: 600;
		white-space: nowrap;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	a[aria-current='page'] {
		color: var(--sl-color-text-accent);
	}

	.bar ul {
		gap: 0.25rem;
		align-items: center;
	}
	.bar a {
		font-size: var(--sl-text-sm);
		padding: 0.35rem 0.65rem;
		border-radius: 0.4rem;
	}
	.bar a[aria-current='page'] {
		background: var(--sl-color-accent-low);
	}

	.list ul {
		flex-direction: column;
		gap: 0.25rem;
		padding-bottom: 1rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}
	.list a {
		padding: 0.4rem 0.5rem;
		border-radius: 0.4rem;
	}
	.list a[aria-current='page'] {
		background: var(--sl-color-accent-low);
	}
</style>
