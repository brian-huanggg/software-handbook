---
// Header in three zones: site title (left), field switcher (centre), search
// and theme switcher (right). Built from Starlight's default
// (dist/components/Header.astro). Below 50rem the switcher and the controls
// are hidden, so they move into the mobile menu instead (see Sidebar.astro).
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import FieldNav from './FieldNav.astro';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex"><SiteTitle /></div>
	<div class="sl-hidden md:sl-flex print:hidden field-nav"><FieldNav variant="bar" /></div>
	<div class="sl-flex print:hidden right-group">
		{shouldRenderSearch && <Search />}
		<div class="sl-hidden md:sl-flex controls">
			<div class="sl-flex social-icons"><SocialIcons /></div>
			<ThemeSelect />
			<LanguageSelect />
		</div>
	</div>
</div>

<script>
	// Hide the fixed header while scrolling down, show it again on scroll up.
	// Desktop only: on mobile the menu button and table of contents are
	// pinned below the header.
	const desktop = window.matchMedia('(min-width: 50rem)');
	const DELTA = 8;
	let lastY = window.scrollY;
	let ticking = false;

	function update() {
		ticking = false;
		const header = document.querySelector('header.header');
		if (!header) return;
		const y = Math.max(window.scrollY, 0);
		const hide = desktop.matches && y > header.clientHeight && y > lastY + DELTA;
		const show = y < lastY - DELTA || y <= header.clientHeight || !desktop.matches;
		if (hide && !header.contains(document.activeElement)) header.classList.add('header-hidden');
		else if (show) header.classList.remove('header-hidden');
		if (hide || show) lastY = y;
	}

	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		},
		{ passive: true },
	);
	// Reveal when keyboard focus lands inside the header.
	document.addEventListener('focusin', (e) => {
		const header = document.querySelector('header.header');
		if (header?.contains(e.target as Node)) header.classList.remove('header-hidden');
	});
</script>

<style is:global>
	header.header {
		transition: transform 0.25s ease;
	}
	header.header.header-hidden {
		transform: translateY(-100%);
	}
	@media (prefers-reduced-motion: reduce) {
		header.header {
			transition: none;
		}
	}
</style>

<style>
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
		overflow: clip;
		/* Avoid clipping focus ring around link inside title wrapper. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
	/* The logo art has a square background; round it like an app icon. */
	.title-wrapper :global(img) {
		border-radius: 22%;
	}

	.right-group,
	.controls,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	/* No social links are configured, so avoid an empty group. */
	.social-icons:empty {
		display: none;
	}

	:global(site-search button) {
		white-space: nowrap;
	}

	@media (min-width: 50rem) {
		/* Side columns share the leftover width equally, so the switcher sits
		   in the middle of the viewport. */
		.header {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
		}
		.right-group {
			justify-self: end;
		}
		.right-group :global(button[data-open-modal]) {
			width: 14rem;
		}
	}

	/* Small desktops: drop the field icons and shrink the search box to its label. */
	@media (max-width: 72rem) {
		.field-nav :global(svg) {
			display: none;
		}
		.right-group :global(button[data-open-modal]) {
			width: auto;
		}
	}
	/* Narrowest desktops: tighter topic pills and no shortcut hint, so the
	   site title keeps its full width. */
	@media (max-width: 64rem) {
		.field-nav :global(a) {
			padding-inline: 0.45rem;
		}
		.right-group :global(button[data-open-modal] kbd) {
			display: none;
		}
	}
</style>
